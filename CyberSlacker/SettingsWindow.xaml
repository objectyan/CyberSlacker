<Window x:Class="CyberSlacker.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CyberSlacker.Converters"
        Title="设置中心" 
        SizeToContent="Height" 
        MaxHeight="850" Width="420" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F3F3F3">

    <Window.Resources>
        <!-- 引入转换器，用于 RadioButton 绑定 int 值 -->
        <local:EnumToBooleanConverter x:Key="IntToBool"/>

        <!-- 定义统一的样式，让界面整洁 -->
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333"/>
        </Style>

        <!-- 1. 滑块 Thumb 的样式 -->
        <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <!-- 滑块外观：圆角矩形 -->
                        <Border x:Name="rectangle"
                            CornerRadius="3"
                            Background="#CCCCCC" 
                            Margin="2,0,2,0" />
                        <ControlTemplate.Triggers>
                            <!-- 鼠标悬停滑块变色 -->
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="rectangle" Property="Background" Value="#2196F3" />
                            </Trigger>
                            <!-- 正在拖动滑块变色 -->
                            <Trigger Property="IsDragging" Value="true">
                                <Setter TargetName="rectangle" Property="Background" Value="#1976D2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 2. 整个 ScrollBar 的样式 -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
            <Setter Property="Width" Value="8"/>
            <!-- 宽度设窄一些，更美观 -->
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="true">
                            <!-- 轨道部分 -->
                            <Track x:Name="PART_Track"
                               IsEnabled="{TemplateBinding IsEnabled}"
                               IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3. ScrollViewer 的样式（用于去掉边缘阴影） -->
        <Style TargetType="{x:Type ScrollViewer}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" 
                                              CanContentScroll="{TemplateBinding CanContentScroll}" 
                                              CanHorizontallyScroll="False" 
                                              CanVerticallyScroll="False" 
                                              ContentTemplate="{TemplateBinding ContentTemplate}" 
                                              Content="{TemplateBinding Content}" 
                                              Grid.Column="0" 
                                              Margin="{TemplateBinding Padding}" 
                                              Grid.Row="0"/>
                            <!-- 垂直滚动条 -->
                            <ScrollBar x:Name="PART_VerticalScrollBar" 
                                  AutomationProperties.AutomationId="VerticalScrollBar" 
                                  Cursor="Arrow" 
                                  Grid.Column="1" 
                                  Maximum="{TemplateBinding ScrollableHeight}" 
                                  Minimum="0" 
                                  Grid.Row="0" 
                                  Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" 
                                  Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                  ViewportSize="{TemplateBinding ViewportHeight}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Padding="25 25 5 10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <!-- 设置项区域：自动伸缩 -->
                <RowDefinition Height="Auto" />
                <!-- 按钮区域：固定高度 -->
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="打工人助手设置" FontSize="20" FontWeight="Bold" Margin="0,0,0,25"/>

                    <TextBlock Text="精准工时" FontWeight="Bold" Margin="0,10,0,10"/>
                    <!-- 考勤时间 -->
                    <TextBlock Text="* 考勤时间" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <ComboBox x:Name="StartHour" Width="60"/>
                        <TextBlock Text=" : " Margin="5,0"/>
                        <ComboBox x:Name="StartMin" Width="60"/>
                        <TextBlock Text=" 至 " Margin="15,0"/>
                        <ComboBox x:Name="EndHour" Width="60"/>
                        <TextBlock Text=" : " Margin="5,0"/>
                        <ComboBox x:Name="EndMin" Width="60"/>
                    </StackPanel>

                    <!-- 点饭提醒 -->
                    <TextBlock Text="* 点饭提醒："  FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <ComboBox x:Name="MealHour" Width="60"/>
                        <TextBlock Text=" : " VerticalAlignment="Center"/>
                        <ComboBox x:Name="MealMin" Width="60"/>
                        <TextBlock Text=" (通常设置午休前10分钟)" FontSize="10" Foreground="Gray" Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- 午休设置 -->
                    <TextBlock Text="* 午休时间：" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <ComboBox x:Name="LunchStartHour" Width="60"/>
                        <TextBlock Text=" : " Margin="5,0"/>
                        <ComboBox x:Name="LunchStartMin" Width="60"/>
                        <TextBlock Text=" 至 " Margin="15,0"/>
                        <ComboBox x:Name="LunchEndHour" Width="60"/>
                        <TextBlock Text=" : "  Margin="5,0"/>
                        <ComboBox x:Name="LunchEndMin" Width="60"/>
                    </StackPanel>

                    <!-- 发薪设置 -->
                    <TextBlock Text="* 发薪日设置" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="每月 "/>
                        <TextBox x:Name="PayDayInput"  Text="{Binding PayDay, UpdateSourceTrigger=PropertyChanged}" Width="50" Padding="3" HorizontalContentAlignment="Center"  PreviewTextInput="NumberValidationTextBox"/>
                        <TextBlock Text=" 号发放"/>
                    </StackPanel>

                    <TextBlock Text="发薪日遇周末策略：" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <RadioButton Content="提前发放" Margin="0,0,15,0"
                             IsChecked="{Binding PaydayStrategy, Converter={StaticResource IntToBool}, ConverterParameter=0}"/>
                        <RadioButton Content="延后发放" 
                             IsChecked="{Binding PaydayStrategy, Converter={StaticResource IntToBool}, ConverterParameter=1}"/>
                    </StackPanel>

                    <!-- 工作制 -->
                    <TextBlock Text="* 工作制" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <RadioButton Content="双休" Margin="0,0,15,0"
                             IsChecked="{Binding WorkMode, Converter={StaticResource IntToBool}, ConverterParameter=0}"/>
                        <RadioButton Content="大小周" Margin="0,0,15,0"
                             IsChecked="{Binding WorkMode, Converter={StaticResource IntToBool}, ConverterParameter=1}"/>
                        <RadioButton Content="单休" 
                             IsChecked="{Binding WorkMode, Converter={StaticResource IntToBool}, ConverterParameter=2}"/>
                    </StackPanel>
                    <TextBlock Text="大小周按单周单休、双周双休计算" FontSize="11" Foreground="Gray" Margin="0,0,0,20"/>

                    <Border BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="0,15,0,0">
                    </Border>

                    <!-- 周期性小憩设置 -->
                    <StackPanel Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox x:Name="RestEnabledCheck" Content="开启久坐提醒" 
       IsChecked="{Binding IsRestEnabled}" VerticalAlignment="Center"/>
                            <TextBlock Text="(每隔一段时间提醒活动)" FontSize="11" Foreground="Gray" Margin="10,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsRestEnabled}">
                            <TextBlock Text="提醒间隔：" Width="80"/>
                            <!-- 使用 Slider 滑动选择 30-120 分钟 -->
                            <Slider x:Name="RestIntervalSlider" Minimum="30" Maximum="120" Width="180" 
     Value="{Binding RestInterval}" TickFrequency="5" IsSnapToTickEnabled="True"/>
                            <TextBlock Text="{Binding RestInterval}" Margin="10,0,0,0" FontWeight="Bold"/>
                            <TextBlock Text=" 分钟"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 下班提醒 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="下班提醒："  Width="80"/>
                        <TextBlock Text="提前 " Margin="10,0,0,0"/>
                        <Slider Minimum="5" Maximum="120" Width="150" Value="{Binding PreOffWorkMins}" TickFrequency="5" IsSnapToTickEnabled="True"/>
                        <TextBlock Text="{Binding PreOffWorkMins}" FontWeight="Bold"/>
                        <TextBlock Text=" 分钟"/>
                    </StackPanel>

                    <!-- 外观设置 -->
                    <Border BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="0,5,0,0">
                    </Border>
                    <TextBlock Text="外观设置" FontWeight="Bold" Margin="0,10,0,10"/>
                    <StackPanel Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="透明度：" Width="80"/>
                            <Slider Value="{Binding Opacity, Mode=TwoWay}" Minimum="0.2" Maximum="1.0" Width="200" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                            <TextBlock Text="{Binding Opacity, StringFormat={}{0:P0}}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 系统设置 -->
                    <Border BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="0,15,0,0">
                        <CheckBox Content="开机自动启动" FontSize="13"
                          IsChecked="{Binding IsAutoStart, Mode=TwoWay}"/>
                    </Border>
                    <Border BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="0,15,0,0" Margin="0,10">
                        <StackPanel>
                            <CheckBox Content="参与预览体验计划 (接收开发版更新)" 
                  IsChecked="{Binding IsPreviewEnabled, Mode=TwoWay}"
                  FontSize="13"/>
                            <TextBlock Text="* 开启后将优先收到包含新功能但可能不稳定的版本推送。" 
                   FontSize="11" Foreground="#FF8C00" Margin="25,5,0,0"/>
                        </StackPanel>
                    </Border>



                </StackPanel>
            </ScrollViewer>
            <!-- 底部按钮 -->
            <Button Grid.Row="1" Content="保存并应用" Click="OnSave_Click" 
                Margin="0,15,0,0" Height="35" Width="120" 
                HorizontalAlignment="Right" Background="#2196F3" Foreground="White" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Border>
</Window>