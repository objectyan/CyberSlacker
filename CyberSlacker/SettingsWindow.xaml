<Window x:Class="CyberSlacker.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CyberSlacker.Converters"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="设置中心" Width="460" Height="650"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei">

    <Window.Resources>
        <local:EnumToBooleanConverter x:Key="IntToBool"/>

        <!-- 通用卡片样式 -->
        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- 文字样式 -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="HeaderLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gold"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- 自定义 Slider 颜色 -->
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#00E5FF"/>
            </Style.Resources>
        </Style>

        <!-- 自定义 RadioButton 样式 (赛博蓝) -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- 窗口外壳 -->
    <Grid>
        <Border Margin="15" Background="#F21A1A1A" CornerRadius="20" BorderBrush="#44FFFFFF" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- 标题 -->
                    <RowDefinition Height="*"/>
                    <!-- 内容 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 底部按钮 -->
                </Grid.RowDefinitions>

                <!-- 1. 标题栏 (支持拖动) -->
                <Grid Grid.Row="0" Margin="25,20,25,10" MouseLeftButtonDown="OnHeaderDrag">
                    <TextBlock Text="赛博助手设置" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" 
                        Background="Transparent" BorderThickness="0" Foreground="#666" 
                        FontSize="18" Cursor="Hand" Click="OnCloseClick"/>
                </Grid>

                <!-- 2. 设置内容区 -->
                <ScrollViewer Grid.Row="1" Margin="20,10" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">

                        <!-- 分区：考勤与点餐配置 -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="⏱️ 精准工时" Style="{StaticResource HeaderLabel}"/>

                                <!-- 考勤时间 -->
                                <TextBlock Text="考勤时间" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <ComboBox x:Name="StartHour" Width="55"/>
                                    <TextBlock Text=":" Margin="5,0"/>
                                    <ComboBox x:Name="StartMin" Width="55"/>
                                    <TextBlock Text="至" Margin="10,0"/>
                                    <ComboBox x:Name="EndHour" Width="55"/>
                                    <TextBlock Text=":" Margin="5,0"/>
                                    <ComboBox x:Name="EndMin" Width="55"/>
                                </StackPanel>

                                <!-- 🌟 补全：点餐提醒 -->
                                <TextBlock Text="点餐提醒" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <ComboBox x:Name="MealHour" Width="55"/>
                                    <TextBlock Text=":" Margin="5,0"/>
                                    <ComboBox x:Name="MealMin" Width="55"/>
                                    <TextBlock Text="(通常设为午休前10分钟)" FontSize="10" Foreground="#666" Margin="10,0,0,0"/>
                                </StackPanel>

                                <!-- 午休时段 -->
                                <TextBlock Text="午休时段" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="LunchStartHour" Width="55"/>
                                    <TextBlock Text=":" Margin="5,0"/>
                                    <ComboBox x:Name="LunchStartMin" Width="55"/>
                                    <TextBlock Text="至" Margin="10,0"/>
                                    <ComboBox x:Name="LunchEndHour" Width="55"/>
                                    <TextBlock Text=":" Margin="5,0"/>
                                    <ComboBox x:Name="LunchEndMin" Width="55"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 分区：金钱与制度 -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="💰 财务与工作制" Style="{StaticResource HeaderLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <TextBlock Text="发薪日：每月 "/>
                                    <TextBox x:Name="PayDayInput" Width="40" Background="#33000000" Foreground="White" BorderBrush="#44FFFFFF"
                                         Text="{Binding PayDay, UpdateSourceTrigger=PropertyChanged}" 
                                         HorizontalContentAlignment="Center" PreviewTextInput="NumberValidationTextBox"/>
                                    <TextBlock Text=" 号"/>
                                </StackPanel>

                                <TextBlock Text="发薪策略 (遇周末)" FontSize="12" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <RadioButton Content="提前发放" IsChecked="{Binding PaydayStrategy, Converter={StaticResource IntToBool}, ConverterParameter=0}"/>
                                    <RadioButton Content="延后发放" IsChecked="{Binding PaydayStrategy, Converter={StaticResource IntToBool}, ConverterParameter=1}"/>
                                </StackPanel>

                                <TextBlock Text="工作制" FontSize="12" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="双休" IsChecked="{Binding WorkMode, Converter={StaticResource IntToBool}, ConverterParameter=0}"/>
                                    <RadioButton Content="大小周" IsChecked="{Binding WorkMode, Converter={StaticResource IntToBool}, ConverterParameter=1}"/>
                                    <RadioButton Content="单休" IsChecked="{Binding WorkMode, Converter={StaticResource IntToBool}, ConverterParameter=2}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 分区：健康提醒 -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="💧 赛博回血" Style="{StaticResource HeaderLabel}"/>
                                <CheckBox Content="开启久坐提醒" Foreground="White" IsChecked="{Binding IsRestEnabled}"/>
                                <StackPanel Margin="0,10,0,0" IsEnabled="{Binding IsRestEnabled}">
                                    <Grid>
                                        <TextBlock Text="提醒间隔"/>
                                        <TextBlock Text="{Binding RestInterval, StringFormat={}{0} 分钟}" HorizontalAlignment="Right" Foreground="#00E5FF"/>
                                    </Grid>
                                    <Slider Minimum="30" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding RestInterval}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 分区：系统与外观 -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="🛠️ 系统环境" Style="{StaticResource HeaderLabel}"/>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="挂件透明度"/>
                                    <TextBlock Text="{Binding Opacity, StringFormat={}{0:P0}}" HorizontalAlignment="Right" Foreground="#00E5FF"/>
                                </Grid>
                                <Slider Minimum="0.2" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Opacity}"/>

                                <CheckBox Content="开机自动启动" Margin="0,15,0,5" IsChecked="{Binding IsAutoStart}"/>
                                <CheckBox Content="预览版计划" IsChecked="{Binding IsPreviewEnabled}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. 底部按钮 -->
                <Grid Grid.Row="2" Margin="25,0,25,25">
                    <Button Content="保 存 并 应 用" x:Name="SaveButton" Click="OnSave_Click" Height="40"
                        Background="#2196F3" Foreground="White" FontSize="14" FontWeight="Bold" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Grid>
        </Border>
        <!-- 赛博悬浮通知条 (Snackbar) 初始状态：透明且向下偏移 -->
        <Border x:Name="MsgBar" 
        VerticalAlignment="Bottom" 
        HorizontalAlignment="Center"
        Margin="0,0,0,110" 
        Padding="18,10"
        CornerRadius="20"
        BorderBrush="#66FFFFFF" 
        BorderThickness="1"
        IsHitTestVisible="False"
        Opacity="0"
        RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform x:Name="MsgTransform" Y="30"/>
            </Border.RenderTransform>
            <Border.Effect>
                <!-- 默认发光，颜色由后台控制 -->
                <DropShadowEffect x:Name="MsgGlow" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="MsgIcon" Text="⚠️" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="14"/>
                <TextBlock x:Name="MsgText" Text="提示信息" Foreground="White" 
                   FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>