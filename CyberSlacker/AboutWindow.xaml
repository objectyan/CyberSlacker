<Window x:Class="CyberSlacker.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="关于赛博摸鱼员"  SizeToContent="Height" MaxHeight="850" Width="350" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F9F9F9" FontFamily="Microsoft YaHei">
    <Grid>
        <StackPanel Margin="15" VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- 1. Logo (这里可以直接引用你的 app.ico) -->
            <Image Source="/Resources/app.ico" Width="32" Height="32" Margin="0,15,0,15" 
                   RenderOptions.BitmapScalingMode="HighQuality"
                   UseLayoutRounding="True"
                   SnapsToDevicePixels="True">
                <Image.Effect>
                    <!-- 甚至可以加一点淡淡的阴影，增加赛博感 -->
                    <DropShadowEffect BlurRadius="50" Opacity="0.2" ShadowDepth="2"/>
                </Image.Effect>
            </Image>

            <!-- 2. 标题与版本 -->
            <TextBlock Text="赛博摸鱼员" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#333"/>
            <TextBlock x:Name="VersionText" Text="Version 1.0.0" FontSize="12" HorizontalAlignment="Center" Foreground="#888" Margin="0,5,0,20"/>

            <!-- 3. 宣言 -->
            <StackPanel Background="#E1F5FE" Margin="0,0,0,25">
                <TextBlock Text="“钱是老板的，命是自己的”" FontStyle="Italic" Foreground="#0288D1" Margin="10" HorizontalAlignment="Center"/>
                <TextBlock Text="“每一秒专注的摸鱼，都是对生命尊严的无声挽留。”" FontStyle="Italic" Foreground="#0288D1" Margin="5" HorizontalAlignment="Center"/>
            </StackPanel>


            <!-- 4. 链接区域 -->
            <StackPanel>
                <TextBlock HorizontalAlignment="Center">
                    官方主页：<Hyperlink NavigateUri="https://github.com/objectyan/CyberSlacker" RequestNavigate="OnNavigate">GitHub 仓库</Hyperlink>
                </TextBlock>
                <TextBlock HorizontalAlignment="Center">
                    反馈建议：<Hyperlink NavigateUri="https://github.com/objectyan/CyberSlacker/issues" RequestNavigate="OnNavigate">提交 Issue</Hyperlink>
                </TextBlock>
                <TextBlock HorizontalAlignment="Center">
                    法律协议：<Hyperlink NavigateUri="https://github.com/objectyan/CyberSlacker/blob/master/LICENSE" RequestNavigate="OnNavigate">开源协议 (MIT)</Hyperlink>
                </TextBlock>
            </StackPanel>

            <Button x:Name="updateBtn" Content="检查更新" 
                    Click="OnCheckUpdate"
                    Margin="0,20,0,0"
                    Padding="20,5"
                    Background="#2196F3" 
                    Foreground="White" 
                    FontWeight="Bold"
                    Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="15"/>
                        <!-- 圆角按钮 -->
                    </Style>
                </Button.Resources>
            </Button>

            <!-- 5. 底部版权 -->
            <TextBlock FontSize="10" Foreground="#AAA" HorizontalAlignment="Center" Margin="0,15,0,0">
                <TextBlock.Text>
                    <Binding Source="{x:Static sys:DateTime.Now}" Path="Year" StringFormat="Copyright © {0} objectyan" />
                </TextBlock.Text>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>