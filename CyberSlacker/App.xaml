<Application x:Class="CyberSlacker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CyberSlacker"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- 滑块 Thumb 的样式 -->
            <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
                <Setter Property="OverridesDefaultStyle" Value="true"/>
                <Setter Property="IsTabStop" Value="false"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <!-- 滑块外观：圆角矩形 -->
                            <Border x:Name="rectangle"
                CornerRadius="3"
                Background="#CCCCCC" 
                Margin="2,0,2,0" />
                            <ControlTemplate.Triggers>
                                <!-- 鼠标悬停滑块变色 -->
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="rectangle" Property="Background" Value="#2196F3" />
                                </Trigger>
                                <!-- 正在拖动滑块变色 -->
                                <Trigger Property="IsDragging" Value="true">
                                    <Setter TargetName="rectangle" Property="Background" Value="#1976D2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 整个 ScrollBar 的样式 -->
            <Style TargetType="{x:Type ScrollBar}">
                <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
                <Setter Property="Width" Value="8"/>
                <!-- 宽度设窄一些，更美观 -->
                <Setter Property="Margin" Value="0,5,0,5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="true">
                                <!-- 轨道部分 -->
                                <Track x:Name="PART_Track"
                   IsEnabled="{TemplateBinding IsEnabled}"
                   IsDirectionReversed="true">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBarThumb}" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ScrollViewer 的样式（用于去掉边缘阴影） -->
            <Style TargetType="{x:Type ScrollViewer}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollViewer}">
                            <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" 
                                  CanContentScroll="{TemplateBinding CanContentScroll}" 
                                  CanHorizontallyScroll="False" 
                                  CanVerticallyScroll="False" 
                                  ContentTemplate="{TemplateBinding ContentTemplate}" 
                                  Content="{TemplateBinding Content}" 
                                  Grid.Column="0" 
                                  Margin="{TemplateBinding Padding}" 
                                  Grid.Row="0"/>
                                <!-- 垂直滚动条 -->
                                <ScrollBar x:Name="PART_VerticalScrollBar" 
                      AutomationProperties.AutomationId="VerticalScrollBar" 
                      Cursor="Arrow" 
                      Grid.Column="1" 
                      Maximum="{TemplateBinding ScrollableHeight}" 
                      Minimum="0" 
                      Grid.Row="0" 
                      Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" 
                      Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" 
                      ViewportSize="{TemplateBinding ViewportHeight}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 彻底干掉滚动条的样式 -->
            <Style x:Key="{x:Static ToolBar.SeparatorStyleKey}" TargetType="Separator">
                <Setter Property="Background" Value="#33FFFFFF"/>
                <Setter Property="Margin" Value="35,4,10,4"/>
                <Setter Property="Height" Value="0.6"/>
            </Style>

            <!-- 精制 MenuItem 样式 -->
            <Style TargetType="MenuItem">
                <Setter Property="Foreground" Value="#EEEEEE"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
                <!-- 解决文字模糊 -->
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <!-- 调整 Margin 和 Padding -->
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Margin="5,1,5,1" SnapsToDevicePixels="True">
                                <Grid Height="38">
                                    <!-- 固定高度，防止出现滚动条 -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter x:Name="Icon" ContentSource="Icon" Grid.Column="0" 
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <ContentPresenter x:Name="Header" ContentSource="Header" Grid.Column="1" 
                                              VerticalAlignment="Center" Margin="5,0,20,0" 
                                              RecognizesAccessKey="True"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- 悬停效果：使用更柔和的颜色 -->
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#25FFFFFF"/>
                                    <Setter Property="Foreground" Value="#00E5FF"/>
                                </Trigger>

                                <!-- 状态区分：当 IsChecked 为 True 时 -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="#00E5FF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

            </Style>

            <!-- ContextMenu 容器样式 -->
            <Style x:Key="CyberContextMenu" TargetType="ContextMenu">
                <Setter Property="Background" Value="#F91A1A1A"/>
                <!-- 略微加深背景 -->
                <Setter Property="BorderBrush" Value="#44FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="MinWidth" Value="180"/>
                <!-- 禁用滚动条显示 -->
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12">
                                <Border.Effect>
                                    <!-- 加上深邃的投影 -->
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.7" Color="Black"/>
                                </Border.Effect>
                                <!-- 强制 ItemsPresenter 撑开高度，不准滚动 -->
                                <ItemsPresenter Margin="0,5"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 赛博极简圆环按钮样式 -->
            <Style x:Key="CyberCircleButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <!-- 容器：Grid 必须先闭合，Triggers 才能开始 -->
                            <Grid x:Name="RootGrid" Background="Transparent" Width="36" Height="36">
                                <!-- 背景圆环 -->
                                <Ellipse x:Name="BackRing" 
                                         Stroke="#33FFFFFF" 
                                         StrokeThickness="1.5" 
                                         Width="22" Height="22" />

                                <!-- 发光圆环 -->
                                <Ellipse x:Name="GlowRing" 
                                         Stroke="#FF5252" 
                                         StrokeThickness="2" 
                                         Width="22" Height="22" 
                                         Opacity="0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="8" Color="#FF5252" ShadowDepth="0" Opacity="1"/>
                                    </Ellipse.Effect>
                                </Ellipse>

                                <!-- 居中的 X -->
                                <Viewbox Width="10" Height="10">
                                    <Path x:Name="XMark" 
                                          Data="M0,0 L10,10 M0,10 L10,0" 
                                          Stroke="#66FFFFFF" 
                                          StrokeThickness="1.5" 
                                          StrokeStartLineCap="Round" 
                                          StrokeEndLineCap="Round"/>
                                </Viewbox>
                            </Grid>

                            <!-- 触发器部分：必须在 Grid 标签结束后 -->
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="GlowRing" Property="Opacity" Value="1"/>
                                    <Setter TargetName="BackRing" Property="Opacity" Value="0"/>
                                    <Setter TargetName="XMark" Property="Stroke" Value="White"/>
                                    <Setter TargetName="XMark" Property="StrokeThickness" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <!-- 点击缩放反馈 -->
                                    <Setter TargetName="RootGrid" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="RootGrid" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
