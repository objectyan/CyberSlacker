<Window x:Class="CyberSlacker.DownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="赛博进化中" Height="180" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True">

    <Border Background="#F21A1A1A" CornerRadius="20" BorderBrush="#44FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#00E5FF" Opacity="0.3"/>
        </Border.Effect>

        <StackPanel Margin="30" VerticalAlignment="Center">
            <!-- 1. 标题和百分比 -->
            <Grid Margin="0,0,0,15">
                <TextBlock Text="正在下载新基因..." Foreground="#00E5FF" FontWeight="Bold" FontSize="14"/>
                <TextBlock x:Name="PercentTxt" Text="0%" Foreground="White" HorizontalAlignment="Right"/>
            </Grid>

            <!-- 2. 赛博风格进度条 -->
            <Grid Height="10">
                <Border Background="#33FFFFFF" CornerRadius="5"/>
                <Border x:Name="ProgressBar" Background="#00E5FF" CornerRadius="5" Width="0" HorizontalAlignment="Left">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Color="#00E5FF" ShadowDepth="0" Opacity="0.8"/>
                    </Border.Effect>
                </Border>
            </Grid>

            <!-- 3. 下载速度和大小 -->
            <TextBlock x:Name="StatusTxt" Text="准备下载..." Foreground="#666" FontSize="10" Margin="0,10,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>