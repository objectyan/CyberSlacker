{
    "disable_default": true,
    "template": "#{{CHANGELOG}}",
    "pr_template": "- #{{TITLE}} (`#{{MERGE_SHA}}`) - #{{MERGED_AT}} (by @#{{AUTHOR}}",
    "commit_template": "- #{{TITLE}} (`#{{MERGE_SHA}}`) - #{{CREATED_AT}} (by @#{{AUTHOR}})",
    "categories": [
        {
            "title": "## 🚀 赛博特性 (Features)",
            "labels": [
                "feat",
                "feature"
            ]
        },
        {
            "title": "## 🐛 故障修复 (Bug Fixes)",
            "labels": [
                "fix",
                "hotfix",
                "bug"
            ]
        },
        {
            "title": "## 📦 基础设施 (Maintenance)",
            "labels": [
                "chore",
                "deps",
                "dep",
                "ci",
                "build"
            ]
        },
        {
            "title": "## 📝 文档更新 (Docs)",
            "labels": [
                "docs",
                "docs:",
                "readme"
            ]
        },
        {
            "title": "## 📌 其他变更 (Other)",
            "labels": []
        }
    ],
    "label_extractor": [
        {
            "method": "match",
            "pattern": "^([\\w\\-]+)",
            "target": "$1",
            "on_property": "title"
        }
    ],
    "ignore_labels": [
        "ignore",
        "Merge branch",
        "\\[skip ci\\]",
        "update Preview manifests"
    ],
    "sort": {
        "order": "DESC",
        "on_property": "mergedAt"
    }
}