{
    "disable_default": true,
    "template": "#{{CHANGELOG}}",
    "pr_template": "- #{{TITLE}} (`#{{MERGE_SHA}}`) - @#{{AUTHOR}}",
    "commit_template": "- #{{TITLE}} (`#{{MERGE_SHA}}`) - @#{{AUTHOR}}",
    "categories": [
        {
            "title": "## 🚀 赛博特性 (Features)",
            "labels": [
                "feat",
                "feature",
                "Feature"
            ]
        },
        {
            "title": "## 🐛 故障修复 (Bug Fixes)",
            "labels": [
                "fix",
                "bug",
                "Bug",
                "hotfix"
            ]
        },
        {
            "title": "## 📦 基础设施 (Maintenance)",
            "labels": [
                "chore",
                "ci",
                "build",
                "deps"
            ]
        },
        {
            "title": "## 📝 文档更新 (Docs)",
            "labels": [
                "docs",
                "readme"
            ]
        }
    ],
    "transformers": [
        {
            "method": "match",
            "pattern": ".*(Merge branch|\\[skip ci\\]|update Preview manifests).*",
            "target": "ignore-this-commit",
            "on_property": [
                "title",
                "labels",
                "body"
            ]
        }
    ],
    "label_extractor": [
        {
            "method": "match",
            "pattern": ".*(Merge branch|\\[skip ci\\]|update Preview manifests).*",
            "target": "ignore-this-commit",
            "on_property": [
                "title",
                "labels",
                "body"
            ]
        },
        {
            "method": "match",
            "pattern": "^([\\w\\-]+)",
            "target": "$1",
            "on_property": [
                "title",
                "labels",
                "body"
            ]
        }
    ],
    "sort": {
        "order": "DESC",
        "on_property": "mergedAt"
    },
    "ignore_labels": [
        "ignore-this-commit",
        "ignore",
        "Merge branch",
        "chore: update Preview manifests [skip ci]"
    ]
}