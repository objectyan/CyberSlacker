{
    "exclude": {
        "labels": [
            "skip-changelog"
        ],
        "authors": [
            "github-actions[bot]",
            "actions-user"
        ],
        "commits": [
            "^.*\\[skip ci\\].*$",
            "^Merge branch.*$"
        ]
    },
    "categories": [
        {
            "title": "🚀 赛博特性 (Features)",
            "labels": [
                "feat",
                "feat:",
                "feature"
            ]
        },
        {
            "title": "🐛 故障修复 (Bug Fixes)",
            "labels": [
                "fix",
                "fix:",
                "bug"
            ]
        },
        {
            "title": "📦 基础设施 (Maintenance)",
            "labels": [
                "chore",
                "chore:",
                "ci",
                "build"
            ]
        },
        {
            "title": "📝 文档更新 (Docs)",
            "labels": [
                "docs",
                "docs:",
                "readme"
            ]
        }
    ],
    "categories_as_labels": true,
    "ignore_labels": [
        "skip-changelog"
    ],
    "unmapped_information": {
        "title": "📌 其他变更 (Other)"
    },
    "disable_default": true,
    "template": "${{CHANGELOG}}",
    "pr_template": "${{TITLE}}",
    "empty_template": "无变动明细"
}